# Copy to lab-network.env (gitignored), fill in, then:
#   set -a; . ./lab-network.env; set +a; bash lab-network-config.sh
LAB_INGRESS_IP=<LAN address of the ingress / control-plane node>
UPSTREAM_DNS=<ISP gateway address>   # NOT the router that hands out lab-dns via DHCP (that loops)
UPSTREAM_DNS_FALLBACK=<public resolver, e.g. a well-known anycast DNS>
DNS_NODES="<node-name> <node-name>"   # nodes that should answer DNS on :53
